[user]
	name = Zhu Liang
	email = zhuliangg11@gmail.com
	signingkey = E0ACFC52
[core]
	editor = nano
	autocrlf = input
	excludesfile = /Users/paradite/.gitignore_global
[push]
	default = simple
[alias]
	st = status
	br = branch
	co = checkout
	ch = checkout
	ci = commit
	cim = commit -am
	cims = commit -S -am
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/paradite/.stCommitMsg
	gpgsign = true
